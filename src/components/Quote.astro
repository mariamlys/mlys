---
interface Props {
  text: string;
  author?: string;
}
const { text, author } = Astro.props;
---

<figure class="max-w-3xl mx-auto text-center">
  <span class="font-display text-6xl text-gold leading-none">“</span>
  <blockquote class="font-display text-2xl md:text-3xl text-black leading-snug -mt-4">
    {text}
  </blockquote>
  {author && <figcaption class="mt-6 eyebrow">{author}</figcaption>}
</figure>
