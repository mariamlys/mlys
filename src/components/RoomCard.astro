---
import { fmtGNF, toEUR, toUSD } from '../config/site';

interface Props {
  image: string;
  eyebrow: string;
  title: string;
  text: string;
  priceGNF: number;
  perNight: string;     // "par nuit" / "per night"
  ctaLabel: string;
  ctaHref: string;
}
const { image, eyebrow, title, text, priceGNF, perNight, ctaLabel, ctaHref } = Astro.props;
---

<a href={ctaHref} class="group block bg-ivory border border-grey-3 hover:border-gold transition-colors">
  <div class="aspect-[4/3] overflow-hidden bg-ivory-dark">
    <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
  </div>
  <div class="p-7">
    <span class="eyebrow">{eyebrow}</span>
    <h3 class="mt-2 text-2xl text-black">{title}</h3>
    <p class="mt-3 text-sm text-grey-1 leading-relaxed">{text}</p>
    <div class="mt-5 flex items-end justify-between border-t border-grey-3 pt-4">
      <div>
        <span class="font-display text-2xl text-black">{fmtGNF(priceGNF)}</span>
        <span class="text-sm text-grey-1"> / {perNight}</span>
        <p class="text-xs text-gold-dark mt-0.5">≈ {toEUR(priceGNF)} € · ≈ {toUSD(priceGNF)} $</p>
      </div>
      <span class="text-sm text-gold-dark group-hover:translate-x-1 transition-transform">{ctaLabel} →</span>
    </div>
  </div>
</a>
