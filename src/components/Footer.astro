---
import { SITE } from '../config/site';

interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const base = `/${lang}`;

const t = {
  fr: {
    tagline: "L'appart-hôtel du quartier d'affaires de Conakry.",
    stay: 'Hébergement', studio: 'Studio', suite: 'Suite 2 pièces', book: 'Réserver',
    house: 'Établissement', resto: 'Restaurant', events: 'Événements', location: 'Localisation', about: 'À propos',
    contact: 'Contact', legal: 'Mentions légales', privacy: 'Confidentialité',
    rights: 'Tous droits réservés.',
    slugs: { studio: '/studio', suite: '/suite', book: '/reservation', resto: '/restaurant', events: '/evenements', location: '/localisation', about: '/a-propos', contact: '/contact', legal: '/mentions-legales', privacy: '/confidentialite' },
  },
  en: {
    tagline: 'The serviced apartments of Conakry’s business district.',
    stay: 'Stay', studio: 'Studio', suite: 'Two-room suite', book: 'Book',
    house: 'The house', resto: 'Restaurant', events: 'Events', location: 'Location', about: 'About',
    contact: 'Contact', legal: 'Legal notice', privacy: 'Privacy',
    rights: 'All rights reserved.',
    slugs: { studio: '/studio', suite: '/suite', book: '/booking', resto: '/restaurant', events: '/events', location: '/location', about: '/about', contact: '/contact', legal: '/legal', privacy: '/privacy' },
  },
}[lang];
const s = t.slugs;
---

<footer class="bg-black text-ivory">
  <div class="container-x py-16 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <!-- Marque -->
    <div>
      <span class="block font-display text-2xl">M'LYS APPART</span>
      <p class="mt-4 text-sm text-grey-2 max-w-xs">{t.tagline}</p>
    </div>

    <!-- Hébergement -->
    <div>
      <h4 class="eyebrow !text-gold mb-5">{t.stay}</h4>
      <ul class="space-y-2.5 text-sm text-grey-2">
        <li><a href={`${base}${s.studio}`} class="hover:text-gold transition-colors">{t.studio}</a></li>
        <li><a href={`${base}${s.suite}`} class="hover:text-gold transition-colors">{t.suite}</a></li>
        <li><a href={`${base}${s.book}`} class="hover:text-gold transition-colors">{t.book}</a></li>
      </ul>
    </div>

    <!-- Établissement -->
    <div>
      <h4 class="eyebrow !text-gold mb-5">{t.house}</h4>
      <ul class="space-y-2.5 text-sm text-grey-2">
        <li><a href={`${base}${s.resto}`} class="hover:text-gold transition-colors">{t.resto}</a></li>
        <li><a href={`${base}${s.events}`} class="hover:text-gold transition-colors">{t.events}</a></li>
        <li><a href={`${base}${s.location}`} class="hover:text-gold transition-colors">{t.location}</a></li>
        <li><a href={`${base}${s.about}`} class="hover:text-gold transition-colors">{t.about}</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h4 class="eyebrow !text-gold mb-5">{t.contact}</h4>
      <address class="not-italic text-sm text-grey-2 space-y-2">
        <p>{SITE.address.line1}<br />{SITE.address.line2}<br />{SITE.address.city}, {SITE.address.country}</p>
        <p><a href={SITE.phoneHref} class="hover:text-gold transition-colors">{SITE.phone}</a></p>
        <p><a href={SITE.emailHref} class="hover:text-gold transition-colors">{SITE.email}</a></p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x py-6 flex flex-col sm:flex-row justify-between gap-3 text-xs text-grey-1">
      <p>© {new Date().getFullYear()} M'LYS APPART. {t.rights}</p>
      <div class="flex gap-5">
        <a href={`${base}${s.legal}`} class="hover:text-gold transition-colors">{t.legal}</a>
        <a href={`${base}${s.privacy}`} class="hover:text-gold transition-colors">{t.privacy}</a>
      </div>
    </div>
  </div>
</footer>
