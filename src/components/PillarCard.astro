---
interface Props {
  number: string;   // "01"
  title: string;
  text: string;
}
const { number, title, text } = Astro.props;
---

<div class="border-t border-grey-3 pt-6">
  <span class="font-display text-3xl text-gold">{number}</span>
  <h3 class="mt-3 text-xl text-black">{title}</h3>
  <p class="mt-3 text-sm text-grey-1 leading-relaxed">{text}</p>
</div>
