---
interface Props {
  image: string;
  eyebrow?: string;
  title: string;          // peut contenir du HTML (ex. <em>)
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
}
const { image, eyebrow, title, subtitle, ctaLabel, ctaHref, ctaSecondaryLabel, ctaSecondaryHref } = Astro.props;
---

<section class="relative min-h-[88vh] flex items-end">
  <!-- Image de fond (TODO: remplacer par la vraie photo) -->
  <div class="absolute inset-0 bg-black-soft">
    <img src={image} alt="" class="w-full h-full object-cover opacity-90" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-black/15"></div>
  </div>

  <div class="container-x relative z-10 pb-20 md:pb-28 text-ivory max-w-3xl">
    {eyebrow && <span class="eyebrow !text-gold">{eyebrow}</span>}
    <h1 class="mt-4 text-4xl md:text-6xl leading-[1.05]" set:html={title}></h1>
    {subtitle && <p class="mt-6 text-lg md:text-xl text-grey-2 font-light max-w-xl">{subtitle}</p>}
    {(ctaLabel || ctaSecondaryLabel) && (
      <div class="mt-9 flex flex-wrap gap-4">
        {ctaLabel && ctaHref && <a href={ctaHref} class="btn btn-gold">{ctaLabel}</a>}
        {ctaSecondaryLabel && ctaSecondaryHref && <a href={ctaSecondaryHref} class="btn btn-outline-light">{ctaSecondaryLabel}</a>}
      </div>
    )}
  </div>
</section>
