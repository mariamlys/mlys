---
import { SITE } from '../config/site';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const src = `https://maps.google.com/maps?q=${SITE.gps.lat},${SITE.gps.lng}&hl=${lang}&z=17&output=embed`;
---

<div class="aspect-[16/10] w-full overflow-hidden border border-grey-3 bg-ivory-dark">
  <iframe
    src={src}
    title="Carte M'LYS APPART"
    width="100%"
    height="100%"
    style="border:0"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>
