---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import PillarCard from '../../components/PillarCard.astro';
import RoomCard from '../../components/RoomCard.astro';
import Distances from '../../components/Distances.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import Quote from '../../components/Quote.astro';
import { ROOMS, DISTANCES_EN } from '../../config/site';
---

<Layout
  lang="en"
  path=""
  title="Serviced apartments in the business district"
  description="M'LYS APPART: studios and suites in the heart of Kaloum, a short walk from the embassies and ministries. Transparent rates, breakfast included, negotiable terms for long stays."
>
  <Hero
    image="/images/facade.png"
    eyebrow="Conakry · Kaloum"
    title={`Live Conakry <span class="accent-italic">as if at home</span>,<br/>in the heart of Kaloum.`}
    subtitle="The serviced apartments of the business district. Steps from the embassies, ministries and banks — at a fair, published price."
    ctaLabel="View our accommodation"
    ctaHref="/en/studio"
    ctaSecondaryLabel="Request a quote"
    ctaSecondaryHref="/en/contact"
  />

  <!-- Two axes: location + price -->
  <section class="section">
    <div class="container-x grid md:grid-cols-2 gap-12 md:gap-16">
      <div>
        <span class="eyebrow">Location</span>
        <h2 class="mt-4 text-3xl md:text-4xl">Walking distance to everything that matters in Kaloum.</h2>
        <p class="mt-5 text-grey-1">
          In the heart of the Almamya district, a six-minute walk from the French and German
          embassies, ten minutes from the ministries. No business
          meeting in Kaloum requires a car.
        </p>
        <a href="/en/location" class="link-underline inline-block mt-6 text-sm">See location and access</a>
      </div>
      <div>
        <span class="eyebrow">Price</span>
        <h2 class="mt-4 text-3xl md:text-4xl">A <span class="accent-italic">fair</span>, transparent rate.</h2>
        <p class="mt-5 text-grey-1">
          Published rates, in Guinean francs with euro and dollar equivalents. Buffet breakfast
          included. Sliding-scale, negotiable terms for long stays and corporate, embassy and NGO
          accounts.
        </p>
        <a href="/en/contact" class="link-underline inline-block mt-6 text-sm">Request a corporate offer</a>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section bg-ivory-dark">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">The house</span>
        <h2 class="mt-4 text-3xl md:text-4xl">Four reasons to choose M'LYS APPART.</h2>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <PillarCard number="01" title="The most strategic location" text="Kaloum, the one business district of Conakry. Embassies, ministries and banks a few minutes away on foot." />
        <PillarCard number="02" title="A fair, transparent price" text="Published rates, decreasing with length of stay. No surprises, no intermediary commission." />
        <PillarCard number="03" title="The apartment format, fully equipped" text="Studios with kitchenettes, two-room suites with separate living rooms. Designed for stays that last." />
        <PillarCard number="04" title="La Diversité Signature restaurant" text="Buffet breakfast included, cuisine from here and elsewhere, served continuously." />
      </div>
    </div>
  </section>

  <!-- Accommodation -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Accommodation</span>
        <h2 class="mt-4 text-3xl md:text-4xl">Studios and suites, for a few nights or several months.</h2>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-8">
        <RoomCard
          image={ROOMS.studio.image}
          eyebrow="1 guest"
          title="Studio"
          text="Sitting area, work desk and a fully equipped kitchenette. The essentials of a home for assignments lasting several weeks."
          priceGNF={ROOMS.studio.priceGNF}
          perNight="night"
          ctaLabel="Discover"
          ctaHref="/en/studio"
        />
        <RoomCard
          image={ROOMS.suite.image}
          eyebrow="Up to 3 guests"
          title="Two-room suite"
          text="A separate 25 m² living room, an open kitchen and an independent bedroom. For families and accompanied stays."
          priceGNF={ROOMS.suite.priceGNF}
          perNight="night"
          ctaLabel="Discover"
          ctaHref="/en/suite"
        />
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="section bg-black text-ivory">
    <div class="container-x">
      <Quote text="The address that brings you closer to everything, without ever taking you far from home." author="M'LYS APPART · Kaloum" />
    </div>
  </section>

  <!-- Location -->
  <section class="section">
    <div class="container-x grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <span class="eyebrow">Location</span>
        <h2 class="mt-4 text-3xl md:text-4xl">All of Kaloum, just steps away.</h2>
        <p class="mt-5 text-grey-1">Almamya district, corner of 5th Boulevard and Rue KA 038.</p>
        <div class="mt-8"><Distances items={DISTANCES_EN.slice(0, 6)} /></div>
        <a href="/en/location" class="link-underline inline-block mt-6 text-sm">See all distances</a>
      </div>
      <MapEmbed lang="en" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section bg-ivory-dark">
    <div class="container-x text-center max-w-2xl mx-auto">
      <span class="eyebrow">Booking</span>
      <h2 class="mt-4 text-3xl md:text-4xl">Plan your stay in Kaloum.</h2>
      <p class="mt-5 text-grey-1">Book online or request a tailored offer for your company.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a href="/en/booking" class="btn btn-gold">Book</a>
        <a href="/en/contact" class="btn btn-outline">Request a quote</a>
      </div>
    </div>
  </section>
</Layout>
