---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PriceCard from '../../components/PriceCard.astro';
import Gallery from '../../components/Gallery.astro';
import { ROOMS } from '../../config/site';

const equipements = [
  'Bureau de travail', 'Coin salon', 'Kitchenette équipée (plaques, micro-ondes, réfrigérateur)',
  'Lit double, literie qualité hôtelière', 'Smart TV HD, chaînes internationales', 'Climatisation',
  'Wi-Fi haut débit', "Salle d'eau avec douche", 'Coffre-fort', 'Téléphone', 'Mini-bar',
];
---

<Layout
  lang="fr"
  path="/studio"
  title="Studio"
  description="Studio M'LYS APPART à Kaloum : kitchenette équipée, bureau et coin salon. 950 000 GNF la nuit, petit-déjeuner inclus. Idéal pour les missions de plusieurs semaines."
  image={ROOMS.studio.image}
>
  <PageHero
    image={ROOMS.studio.image}
    eyebrow="1 personne"
    title="Studio"
    subtitle="L'essentiel d'un chez-soi, pour les missions individuelles de plusieurs semaines à plusieurs mois."
  />

  <section class="section">
    <div class="container-x grid lg:grid-cols-[1fr_360px] gap-12">
      <div>
        <span class="eyebrow">L'espace</span>
        <h2 class="mt-4 text-3xl">Un studio pensé pour travailler et se reposer.</h2>
        <p class="mt-5 text-grey-1 max-w-2xl">
          Coin salon, bureau dédié et kitchenette complète : tout l'espace nécessaire pour vivre
          et travailler sereinement pendant une mission longue à Kaloum. Literie de qualité hôtelière,
          climatisation et Wi-Fi haut débit pour un confort sans compromis.
        </p>

        <h3 class="mt-10 text-xl">Équipements</h3>
        <ul class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-2.5">
          {equipements.map((e) => (
            <li class="flex items-start gap-2.5 text-sm text-black-soft">
              <span class="text-gold mt-1.5 w-1 h-1 rounded-full bg-gold flex-shrink-0"></span>{e}
            </li>
          ))}
        </ul>

        <div class="mt-12">
          <Gallery images={[
            { src: ROOMS.studio.image, alt: 'Studio M\'LYS APPART' },
            { src: '/images/studio-large.jpg', alt: 'Studio avec lit et salon' },
            { src: '/images/studio-bureau.jpg', alt: 'Bureau du studio' },
          ]} />
        </div>
      </div>

      <PriceCard
        priceGNF={ROOMS.studio.priceGNF}
        label="par nuit"
        note="Petit-déjeuner buffet inclus. Tarifs dégressifs sur demande pour les longs séjours et comptes entreprises."
        ctaLabel="Réserver"
        ctaHref="/fr/reservation"
        secondaryLabel="Demander un devis"
        secondaryHref="/fr/contact"
      />
    </div>
  </section>
</Layout>
