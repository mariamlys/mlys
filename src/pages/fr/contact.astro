---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE } from '../../config/site';
---

<Layout
  lang="fr"
  path="/contact"
  title="Devis & contact"
  description="Demandez un devis personnalisé pour votre séjour à M'LYS APPART. Conditions négociables pour les entreprises, ambassades et ONG. Réponse rapide."
>
  <PageHero
    eyebrow="Contact"
    title="Demandez votre <span class='accent-italic'>devis</span>."
    subtitle="Séjour individuel, mission longue ou compte entreprise : dites-nous votre besoin, nous revenons vers vous rapidement."
  />

  <section class="section">
    <div class="container-x grid lg:grid-cols-[1fr_320px] gap-12">
      <div>
        <ContactForm lang="fr" />
      </div>
      <aside class="bg-ivory-dark p-8 h-fit">
        <h3 class="eyebrow">Nous joindre</h3>
        <address class="not-italic mt-5 text-sm text-grey-1 space-y-3">
          <p>{SITE.address.line2}<br />{SITE.address.line1}<br />{SITE.address.city}, {SITE.address.country}</p>
          <p><a href={SITE.phoneHref} class="link-underline">{SITE.phone}</a></p>
          <p><a href={SITE.emailHref} class="link-underline">{SITE.email}</a></p>
        </address>
        <p class="mt-6 text-sm text-grey-1 border-t border-grey-3 pt-5">
          Comptes entreprises, ambassades et ONG : tarifs dégressifs et conditions négociables
          pour les longs séjours.
        </p>
      </aside>
    </div>
  </section>
</Layout>
