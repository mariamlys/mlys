---
// Page racine. Redirige selon la langue du navigateur (FR par défaut).
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>M'LYS APPART · Conakry</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://mlysappart.com/fr/" />
    <!-- Fallback sans JS : FR par défaut -->
    <meta http-equiv="refresh" content="0; url=/fr/" />
    <script is:inline>
      const lang = (navigator.language || 'fr').toLowerCase();
      window.location.replace(lang.startsWith('en') ? '/en/' : '/fr/');
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem;">
      Redirection… / Redirecting… <a href="/fr/">Continuer</a>
    </p>
  </body>
</html>
