# Copier ce fichier en ".env" et remplir les valeurs.
# (le préfixe PUBLIC_ est nécessaire pour qu'Astro l'expose au formulaire)

# Endpoint Formspree — créer un compte gratuit sur https://formspree.io
# puis coller ici l'URL du formulaire (forme : https://formspree.io/f/abcdwxyz)
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
